# Copy to .env (`make infra` does this automatically). Real values never get committed.
# These are local-development defaults, not secrets.

# --- docker compose (infra/docker-compose.dev.yml) ---
POSTGRES_USER=lookalike
POSTGRES_PASSWORD=lookalike
POSTGRES_DB=lookalike
# Host port. 5433 (not 5432) so it never collides with a locally installed Postgres.
POSTGRES_PORT=5433
REDIS_PORT=6379

# --- API (apps/api) ---
APP_ENV=dev
LOG_LEVEL=INFO
# true = JSON lines (default, what production uses); false = human-readable console output.
LOG_JSON=true
DATABASE_URL=postgresql+asyncpg://lookalike:lookalike@localhost:5433/lookalike
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000
