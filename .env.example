# .env болгож хуулна (`make infra` үүнийг автоматаар хийнэ). Жинхэнэ утгыг хэзээ ч commit хийхгүй.
# Эдгээр нь дотоод хөгжүүлэлтийн анхдагч утга, нууц биш.

# --- docker compose (infra/docker-compose.dev.yml) ---
POSTGRES_USER=angel
POSTGRES_PASSWORD=angel
POSTGRES_DB=angel
# Хост порт. Суулгасан Postgres-тэй зөрчилдөхгүйн тулд 5432 биш 5433.
POSTGRES_PORT=5433
REDIS_PORT=6379

# --- API (apps/api) ---
APP_ENV=dev
LOG_LEVEL=INFO
# true = JSON мөр (анхдагч, production-д ашиглагддаг); false = хүнд уншигдахуйц console гаралт.
LOG_JSON=true
DATABASE_URL=postgresql+asyncpg://angel:angel@localhost:5433/angel
REDIS_URL=redis://localhost:6379/0
# CORS-оор зөвшөөрөх browser origin-ууд (таслалаар тусгаарлана).
CORS_ORIGINS=http://localhost:3000

# --- зураг ба ML (apps/api) ---
# Thumbnail бичигдэх (мөн /media хаягаар үйлчлэх) фолдер. apps/api-аас харьцангуй зам.
MEDIA_DIR=../../data/media
MEDIA_URL_PATH=/media
MEDIA_BASE_URL=http://localhost:8000/media
# Kaggle "Fashion Product Images" фолдер: styles.csv болон images/ байна (`make ingest` ашиглана).
DATASET_DIR=/Users/you/Datasets/fashion
# fashion-clip = жинхэнэ загвар. fake = CI-ийн end-to-end тестэд зориулсан тогтмол хиймэл загвар
# (татах хэрэггүй, үр дүн утгагүй); APP_ENV=prod үед ашиглахыг хориглоно.
EMBEDDER=fashion-clip
# auto = эхлээд CUDA, дараа нь Apple MPS, эцэст нь CPU
EMBEDDING_DEVICE=auto
EMBEDDING_FP16=false
# Үүнийг солибол embedding-ийн утга өөрчлөгдөнө: дараа нь `make ingest ARGS=--reembed` ажиллуулна.
EMBEDDING_RESIZE_MODE=pad

# --- хайлт (apps/api) ---
# Оруулах зургийг хэмжээ болон пикселийн тоогоор хязгаарлана (decompression bomb-оос хамгаалах).
MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_PIXELS=25000000
SEARCH_DEFAULT_LIMIT=24
# Холимог хайлт ("үүнтэй адил, гэхдээ ...") дахь текстийн жин.
HYBRID_TEXT_WEIGHT=0.65
DETECTED_CATEGORIES=3
# Redis cache (текстийн embedding, төстэй бараа).
TEXT_EMBEDDING_CACHE_TTL_SECONDS=86400
SIMILAR_CACHE_TTL_SECONDS=300
CATALOG_FILTERS_CACHE_TTL_SECONDS=600
REDIS_OP_TIMEOUT_SECONDS=0.5
# Клиентийн хаяг тутмын хүсэлтийн хязгаар: "<хүсэлтийн тоо>/<цонхны секунд>".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IMAGE=20/60
RATE_LIMIT_TEXT=60/60
RATE_LIMIT_SIMILAR=120/60
# Зөвхөн өөрийн удирддаг reverse proxy-ийн ард true болгоно (клиентийн хаяг X-Forwarded-For-оос авагдана).
TRUST_PROXY_HEADERS=false

# --- хэрэглэгчийн бүртгэл (apps/api) ---
# Access token-д гарын үсэг зурна. 32+ санамсаргүй тэмдэгт: `openssl rand -base64 48`. APP_ENV=prod үед заавал;
# хөгжүүлэлтэд хоосон үлдээвэл процесс бүрт түлхүүр үүсэх тул дахин асаахад бүгд гарах болно.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# APP_ENV=prod үед заавал true болно. http://localhost-д false үлдээнэ.
COOKIE_SECURE=false
# Клиентийн хаяг тутам, "<хүсэлтийн тоо>/<цонхны секунд>". Амжилтгүй нэвтрэлтийг и-мэйл тутам мөн хязгаарлана.
RATE_LIMIT_REGISTER=5/3600
RATE_LIMIT_LOGIN=10/300
RATE_LIMIT_LOGIN_EMAIL=5/300
RATE_LIMIT_REFRESH=60/60
RATE_LIMIT_ADMIN=120/60
# Сэтгэгдэл бичих, засах, устгах: клиентийн хаяг тутам цонхонд зөвшөөрөх хүсэлт.
RATE_LIMIT_REVIEW=20/3600

# --- нэг удаагийн код: утас/и-мэйлээр нэвтрэх, баталгаажуулах, солих, нууц үг сэргээх (apps/api) ---
# console = мессежийг API-ийн логт бичнэ (кодыг тэндээс уншина). twilio = жинхэнээр илгээнэ
# (APP_ENV=prod үед заавал). Twilio token-г хэзээ ч commit хийхгүй.
SMS_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Улсын кодгүй бичсэн дугаарыг энэ бүс нутгаар уншина (ISO 3166 alpha-2, жишээ нь MN, US, GB).
DEFAULT_PHONE_REGION=US
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
# Клиентийн хаяг тутам, "<хүсэлтийн тоо>/<цонхны секунд>".
RATE_LIMIT_OTP_SEND=10/600
RATE_LIMIT_OTP_VERIFY=30/600
# Хоосон үлдээнэ. Зургаан оронтой тоо өгвөл БҮХ код тэр утга болно: зөвхөн end-to-end тест, demo-д
# (APP_ENV=prod үед ашиглахыг хориглоно).
OTP_DEV_CODE=

# --- сагс ба төлбөр тооцоо (apps/api) ---
CART_MAX_QUANTITY=10
CART_MAX_LINES=50
CART_GUEST_TTL_DAYS=30
SHIPPING_STANDARD_CENTS=499
SHIPPING_EXPRESS_CENTS=1299
# Энэ дүнгээс дээш бол энгийн хүргэлт үнэгүй.
FREE_SHIPPING_THRESHOLD_CENTS=10000
# Захиалга төлбөр хүлээж байхад нөөцийг нөөцөлнө; төлөөгүй захиалга энэ хугацааны дараа нөөцийг буцаана.
ORDER_PENDING_TTL_MINUTES=30

# --- төлбөр (apps/api) ---
# stripe  = жинхэнэ PaymentIntent. Production-оос бусад үед TEST түлхүүр (sk_test_...) ашиглана.
# offline = Stripe огт ашиглахгүй: checkout дээр "төлбөрийг дуурайх" товч гарна. APP_ENV=prod үед хориглоно.
PAYMENTS_MODE=offline
STRIPE_SECRET_KEY=
# `stripe listen --forward-to localhost:8000/api/v1/webhooks/stripe` (whsec_...) эсвэл dashboard-аас авна.
STRIPE_WEBHOOK_SECRET=

# --- Google-ээр нэвтрэх (apps/api) ---
# Client id, secret-ийг хоосон үлдээвэл "Continue with Google" товч харагдахгүй.
# Google Cloud Console дээр үүсгэнэ: OAuth consent screen (External, Testing, өөрийгөө test user болгож нэмнэ),
# дараа нь Credentials > Create OAuth client ID > Web application, доорх redirect URI-тай.
# Дэлгэрэнгүй: docs/commerce.md ("Sign in with Google"). Secret-ийг хэзээ ч commit хийхгүй.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google console дээр яг ингэж бүртгэсэн байх ёстой. WEB origin дээр байна: Next нь /api/v1-ийг API руу дамжуулдаг тул
# callback-ийн тохируулсан session cookie нь сайтынх нь өөрийнх болно.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Callback дууссаны дараа browser-ийг явуулах хаяг (алдаатай бол /login?error=... руу).
WEB_BASE_URL=http://localhost:3000
# google = жинхэнэ урсгал. fake = тест, CI-д зориулсан процесс доторх хиймэл хувилбар (APP_ENV=prod үед хориглоно).
OAUTH_MODE=google

# --- web (apps/web) ---
# Browser API-д хүрэх хаяг.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Сайтын нийтийн хаяг (canonical URL, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Сонголттой, зөвхөн server талд: нийтийн хаягаас өөр байвал Next.js server API-д хүрэх хаяг
# (жишээ нь docker compose дотор http://api:8000). Хоосон бол NEXT_PUBLIC_API_URL-ийг ашиглана.
# API_INTERNAL_URL=

# Энэ тоо ба түүнээс бага үлдэгдэлтэй барааг админ самбарт "нөөц бага" гэж тооцно.
LOW_STOCK_THRESHOLD=5
