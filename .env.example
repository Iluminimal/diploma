# Copy to .env (`make infra` does this automatically). Real values never get committed.
# These are local-development defaults, not secrets.

# --- docker compose (infra/docker-compose.dev.yml) ---
POSTGRES_USER=lookalike
POSTGRES_PASSWORD=lookalike
POSTGRES_DB=lookalike
# Host port. 5433 (not 5432) so it never collides with a locally installed Postgres.
POSTGRES_PORT=5433
REDIS_PORT=6379

# --- API (apps/api) ---
APP_ENV=dev
LOG_LEVEL=INFO
# true = JSON lines (default, what production uses); false = human-readable console output.
LOG_JSON=true
DATABASE_URL=postgresql+asyncpg://lookalike:lookalike@localhost:5433/lookalike
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# --- images and ML (apps/api) ---
# Where thumbnails are written (and served from at /media). Relative to apps/api.
MEDIA_DIR=../../data/media
MEDIA_URL_PATH=/media
MEDIA_BASE_URL=http://localhost:8000/media
# Kaggle "Fashion Product Images" folder containing styles.csv and images/ (used by `make ingest`).
DATASET_DIR=/Users/you/Datasets/fashion
# auto = CUDA, then Apple MPS, then CPU
EMBEDDING_DEVICE=auto
EMBEDDING_FP16=false
# Changing this changes what embeddings mean: re-run `make ingest ARGS=--reembed` afterwards.
EMBEDDING_RESIZE_MODE=pad

# --- search (apps/api) ---
# Uploads are limited by size and by pixel count (decompression bombs).
MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_PIXELS=25000000
SEARCH_DEFAULT_LIMIT=24
# Share of the text in hybrid search ("like this, but ...").
HYBRID_TEXT_WEIGHT=0.65
DETECTED_CATEGORIES=3
# Redis caches (text embeddings, similar products).
TEXT_EMBEDDING_CACHE_TTL_SECONDS=86400
SIMILAR_CACHE_TTL_SECONDS=300
CATALOG_FILTERS_CACHE_TTL_SECONDS=600
REDIS_OP_TIMEOUT_SECONDS=0.5
# Rate limits per client address: "<requests>/<window seconds>".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IMAGE=20/60
RATE_LIMIT_TEXT=60/60
RATE_LIMIT_SIMILAR=120/60
# Set to true only behind a reverse proxy you control (the client address then comes from X-Forwarded-For).
TRUST_PROXY_HEADERS=false

# --- web (apps/web) ---
# Where the browser reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public address of the site (canonical URLs, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, server-side only: how Next.js servers reach the API when that differs from the public
# address (e.g. http://api:8000 inside docker compose). Falls back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=
