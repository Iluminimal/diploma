# Production тохиргоо. `.env.prod` болгож хуулж, бүх CHANGE_ME-г солино. `.env.prod`-ийг хэзээ ч commit хийхгүй
# (.gitignore-д орсон). Дэлгэрэнгүй: docs/deploy.md. `make deploy-check` хоосон, CHANGE_ME үлдсэнийг шалгана.

# --- сайт ---
# Сайтын нийтийн домэйн (Caddy энэ хаяг дээр HTTPS авна) ба бүтэн URL. DNS A/AAAA бичлэг серверийг заасан байх ёстой.
SITE_ADDRESS=shop.example.com
SITE_URL=https://shop.example.com
# Image-ийн tag (rollback-д өмнөх tag-аар дахин асаана).
TAG=latest

# --- өгөгдлийн сан ---
# URL-д орох тул тусгай тэмдэгтгүй: `openssl rand -hex 24`
POSTGRES_USER=angel
POSTGRES_DB=angel
POSTGRES_PASSWORD=CHANGE_ME

# --- API ---
# `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME
LOG_LEVEL=INFO
LOG_JSON=true
DEFAULT_PHONE_REGION=MN

# Загвар: жинхэнэ fashion-clip + YOLO. Анхны асалтад ~1 GB татна (hf-cache volume-д хадгалагдана);
# CPU серверт хөнгөн байлгахыг хүсвэл LOCALIZER=whole.
EMBEDDER=fashion-clip
LOCALIZER=yolo
EMBEDDING_DEVICE=cpu
LOCALIZER_DEVICE=cpu

# --- төлбөр (QPay, https://developer.qpay.mn) ---
PAYMENTS_MODE=qpay
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=CHANGE_ME
QPAY_CLIENT_SECRET=CHANGE_ME
QPAY_INVOICE_CODE=CHANGE_ME

# --- нэг удаагийн код (SMS, Twilio) ---
SMS_MODE=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=CHANGE_ME

# --- имэйл (SMTP) ---
MAIL_MODE=smtp
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_STARTTLS=true
MAIL_FROM=Angel <no-reply@shop.example.com>

# --- Google-ээр нэвтрэх ---
# Redirect URI (Google console-д яг ингэж бүртгэнэ): ${SITE_URL}/api/v1/auth/google/callback
OAUTH_MODE=google
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
