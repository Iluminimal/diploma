# Base URL of the Lookalike API as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public address of the site: canonical URLs, Open Graph, JSON-LD and the sitemap. Must be a full
# URL (https://shop.example.com in production); the build fails if it is not.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
